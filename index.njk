---
permalink: /index.html
root: ""
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>APED Association — Building Hope in Rural Togo</title>

<!-- SEO -->
<meta name="description" content="APED is closing the gap on rural healthcare in southern Togo, West Africa — building the Kpotamé Health Center for 18,000 people across 17 underserved villages.">
<meta name="keywords" content="APED Association, Togo nonprofit, Kpotamé health center, rural healthcare Togo, Avé Prefecture, maternal health, children's education, women's empowerment, West Africa NGO, donate Togo healthcare">
<meta name="author" content="APED Association">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://apedassociation.org/">

<!-- Open Graph (LinkedIn, Facebook, WhatsApp, Slack link previews) -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="APED Association">
<meta property="og:title" content="APED Association — Building Hope in Rural Togo">
<meta property="og:description" content="A mother shouldn't walk 20km in labor. A child shouldn't die from a preventable disease. APED is building healthcare access in rural southern Togo (West Africa) — for 18,000 people across 17 villages.">
<meta property="og:url" content="https://apedassociation.org/">
<meta property="og:image" content="https://apedassociation.org/assets/brand/og-card.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="APED Association — construction site for the Kpotamé Rural Health Center in southern Togo, West Africa">
<meta property="og:locale" content="en_US">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="APED Association — Building Hope in Rural Togo">
<meta name="twitter:description" content="In rural southern Togo, families walk up to 40km for medical care. APED is closing that distance — village by village.">
<meta name="twitter:image" content="https://apedassociation.org/assets/brand/og-card.jpg">

<!-- Favicons -->
<link rel="icon" type="image/png" sizes="32x32" href="assets/brand/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="assets/brand/apple-touch-icon.png">
<link rel="shortcut icon" href="assets/brand/favicon-32.png">

<!-- Theme color for mobile address bar -->
<meta name="theme-color" content="#1A3A6B">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
{% include "styles.njk" %}
</head>
<body>

<!-- NAV -->
{% include "nav.njk" %}

<!-- ════════════════════════════ HOME ════════════════════════════ -->
<div id="page-home" class="page active">

  <!-- HERO -->
  <div class="hero">
    <div class="hero-pattern"></div>
    <div class="hero-left">
      <div class="hero-badge">{{ home.hero.badge }}</div>
      <h1>{{ home.hero.headline | highlight(home.hero.highlight) | safe }}</h1>
      <p class="hero-sub" id="cms-hero-sub">{{ home.hero.paragraph }}</p>
      <div class="hero-actions">
        <a href="#" onclick="showPage('donate')" class="btn-primary">{{ home.hero.primary_button }}</a>
        <a href="#" onclick="showPage('about')" class="btn-outline">{{ home.hero.secondary_button }}</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-img hero-img-top"><div class="hero-img-overlay"></div><div class="hero-caption">{{ home.hero.caption_top }}</div></div>
      <div class="hero-img hero-img-bottom"><div class="hero-img-overlay"></div><div class="hero-caption">{{ home.hero.caption_bottom }}</div></div>
    </div>
  </div>
  <div class="hero-stats">
{%- for s in home.stats %}
    <div class="hero-stat"><div class="hero-stat-num">{{ s.number | tokens }}</div><div class="hero-stat-label">{{ s.label }}</div></div>
{%- endfor %}
  </div>

  <!-- STORY STRIP -->
  <div class="story-strip">
    <div class="story-img-grid">
      <div class="story-img-cell story-img-1"></div>
      <div class="story-img-cell story-img-2"></div>
      <div class="story-img-cell story-img-3"></div>
      <div class="story-img-cell story-img-4"></div>
    </div>
    <div class="story-text">
      <div class="section-label" style="color:rgba(245,194,0,0.9)">{{ home.story.label }}</div>
      <div class="section-title">{{ home.story.title }}</div>
      <p class="section-sub">{{ home.story.paragraph }}</p>
      <blockquote class="story-quote">"{{ home.story.quote }}"</blockquote>
      <a href="#" onclick="showPage('about')" class="btn-primary">{{ home.story.button }}</a>
    </div>
  </div>

  <!-- PROGRAMS -->
  <section style="padding-bottom: 48px; background: var(--white);">
    <div class="section-label">{{ home.programs.label }}</div>
    <div class="section-title" style="max-width:560px;">{{ home.programs.title }}</div>
    <p class="section-sub" style="margin-top:16px;">{{ home.programs.intro }}</p>
    <div class="programs-grid">
{%- for p in home.programs.items %}
      <div class="program-card"{% if p.link_to %} onclick="showPage('{{ p.link_to }}')"{% endif %}>
        <div class="program-icon {{ p.color }}">{{ p.icon }}</div>
        <h3>{{ p.title }}</h3>
        <p>{{ p.text }}</p>
        <a href="#" class="program-link"{% if p.link_to %} onclick="showPage('{{ p.link_to }}')"{% endif %}>{{ p.link_label }}</a>
      </div>
{%- endfor %}
    </div>
  </section>

  <!-- IMPACT NUMBERS — 2023-2025 Cumulative -->
  <div class="impact-section" style="background: var(--gray-100);">
    <div class="section-label">{{ home.impact.label }}</div>
    <div class="section-title" style="margin:0 auto 8px;max-width:620px;">{{ home.impact.title }}</div>
    <p class="section-sub" style="margin:0 auto 16px;text-align:center;">{{ home.impact.intro }}</p>
    <div class="impact-grid">
{%- for i in home.impact.items %}
      <div class="impact-item"><div class="impact-num">{{ i.number }}<span class="impact-unit">{{ i.unit }}</span></div><div class="impact-label">{{ i.label | lines | safe }}{% if i.note %}<br><span style="opacity:.72">{{ i.note }}</span>{% endif %}</div></div>
{%- endfor %}
    </div>
    <div style="margin-top:48px;text-align:center;">
      <a href="#" onclick="showPage('impact')" class="btn-primary" style="background:var(--blue);color:var(--white)">{{ home.impact.button }}</a>
    </div>
  </div>

  <!-- HEALTH CENTER SPOTLIGHT -->
  <div class="spotlight">
    <div class="spotlight-visual">
      <div class="spotlight-photo" id="spotlight-photo"></div>
      <div class="progress-card">
        <h4>{{ home.spotlight.progress_title }}</h4>
        <div class="progress-bar-track"><div class="progress-bar-fill"></div></div>
        <div class="progress-meta"><strong>{{ site.fundraising.raised }} raised</strong><span>Goal: {{ site.fundraising.phase_goal }}</span></div>
      </div>
    </div>
    <div class="spotlight-content">
      <div class="section-label" style="color:rgba(245,194,0,0.85)">{{ home.spotlight.label }}</div>
      <div class="section-title" style="color:var(--white)">{{ home.spotlight.title }}</div>
      <p class="section-sub" style="color:rgba(255,255,255,0.65)">{{ home.spotlight.text }}</p>
      <ul class="milestone-list">
{%- for m in home.spotlight.milestones %}
        <li><div class="milestone-dot {{ m.status }}">{% if m.status == "done" %}✓{% elif m.status == "active" %}▶{% else %}{{ loop.index }}{% endif %}</div><div class="milestone-text"><strong>{{ m.title }}</strong><span>{{ m.detail }}</span></div></li>
{%- endfor %}
      </ul>
      <a href="#" onclick="showPage('project')" class="btn-primary" style="margin-top:32px;display:inline-block;">{{ home.spotlight.button }}</a>
    </div>
  </div>

  <!-- TESTIMONIALS -->
  <div class="testimonials" style="background: var(--white);">
    <div class="section-label">{{ home.testimonials.label }}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:end;margin-bottom:0">
      <div class="section-title">{{ home.testimonials.title }}</div>
    </div>
    <div class="testimonial-grid">
{%- for t in home.testimonials.items %}
      <div class="testimonial-card">
        <p class="testimonial-text">"{{ t.quote }}"</p>
        <div class="testimonial-author"><div class="testimonial-avatar">{{ t.initials }}</div><div><div class="testimonial-name">{{ t.name }}</div><div class="testimonial-role">{{ t.role }}</div></div></div>
      </div>
{%- endfor %}
    </div>
  </div>

  <!-- ACTION CTA -->
  <div style="background:var(--yellow);padding:72px 80px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center;">
    <div>
      <div style="font-size:11px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;color:var(--blue);opacity:0.6;margin-bottom:12px;">{{ home.action.label }}</div>
      <h2 style="font-family:var(--serif);font-size:40px;color:var(--blue);margin-bottom:12px;line-height:1.15;">{{ home.action.title | lines | safe }}</h2>
      <p style="font-size:17px;color:rgba(26,58,107,0.7);max-width:560px;">{{ home.action.text }}</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px;flex-shrink:0;">
      <a href="#" onclick="showPage('donate')" style="background:var(--blue);color:var(--white);font-family:var(--sans);font-weight:700;font-size:16px;padding:18px 36px;border-radius:var(--radius);text-decoration:none;text-align:center;display:block;transition:opacity .2s;" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">{{ home.action.donate_button }}</a>
      <a href="#" onclick="showPage('involve')" style="background:transparent;color:var(--blue);font-family:var(--sans);font-weight:500;font-size:14px;padding:10px;text-decoration:none;text-align:center;display:block;border:1.5px solid rgba(26,58,107,0.3);border-radius:var(--radius);">{{ home.action.volunteer_button }}</a>
    </div>
  </div>

  <!-- NEWSLETTER -->
  <div class="newsletter">
    <div class="newsletter-text">
      <h2>{{ home.newsletter.title }}</h2>
      <p>{{ home.newsletter.text }}</p>
    </div>
    <form class="newsletter-form" data-ls-form="lwq6BdFgS6AoJDZUUkNE" novalidate>
      <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" data-ls-field="_hp" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
        <input type="email" class="newsletter-input" name="Email" data-ls-field="email" placeholder="your@email.com" aria-label="Email address" required>
        <button type="submit" class="newsletter-btn">{{ home.newsletter.button }}</button>
      </form>
  </div>
</div>

<!-- ════════════════════════════ ABOUT ════════════════════════════ -->
<div id="page-about" class="page">
  <div class="about-hero">
    <div>
      <div class="section-label">{{ about.hero.label }}</div>
      <div class="section-title">{{ about.hero.title }}</div>
      <p class="section-sub" style="margin-top:16px">{{ about.hero.text }}</p>
      <a href="#" onclick="showPage('donate')" class="btn-primary" style="margin-top:32px;display:inline-block;">{{ about.hero.button }}</a>
    </div>
    <div style="background-size:cover;background-position:center;border-radius:var(--radius-lg);aspect-ratio:4/3;" id='about-hero-img'></div>
  </div>

  <div class="about-body">
    <div class="section-label">{{ about.mission.label }}</div>
    <div class="section-title">{{ about.mission.title }}</div>
    <p class="section-sub" id="cms-mission" style="margin-top:20px">{{ about.mission.text }}</p>

    <div class="values-grid">
{%- for v in about.values %}
      <div class="value-card">
        <div class="value-num">{{ loop.index | pad2 }}</div>
        <h3>{{ v.title }}</h3>
        <p>{{ v.text }}</p>
      </div>
{%- endfor %}
    </div>
  </div>

  <!-- TEAM -->
  <div class="team-section">
    <div style="text-align:center;max-width:760px;margin:0 auto 24px;">
      <div class="section-label">{{ about.team_section.label }}</div>
      <div class="section-title">{{ about.team_section.title }}</div>
      <p class="section-sub" style="margin:16px auto 0;">{{ about.team_section.text }}</p>
    </div>
    <div class="team-grid">
{%- for m in team.members %}
      <div class="team-card">
        {% if m.photo %}<img class="team-photo" width="140" height="140" loading="lazy" decoding="async" src="{{ m.photo | asset }}" alt="{{ m.name }}">{% endif %}
        <div class="team-name">{{ m.name }}</div>
        <div class="team-role">{{ m.role }}</div>
      </div>
{%- endfor %}
    </div>
  </div>

  <!-- TERRITORY -->
  <div class="territory">
    <div class="territory-inner">
      <div>
        <div class="section-label" style="color:rgba(245,194,0,0.85)">{{ about.territory.label }}</div>
        <h2>{{ about.territory.title }}</h2>
{%- for para in about.territory.paragraphs %}
        <p>{{ para }}</p>
{%- endfor %}
      </div>
      <div>
        <div style="color:rgba(255,255,255,0.5);font-size:13px;letter-spacing:1px;text-transform:uppercase;margin-bottom:16px;">{{ about.territory.municipality_1_label }}</div>
        <div class="canton-grid">
{%- for c in about.territory.municipality_1 %}
          <div class="canton"><strong>Canton</strong>{{ c }}</div>
{%- endfor %}
        </div>
        <div style="color:rgba(255,255,255,0.5);font-size:13px;letter-spacing:1px;text-transform:uppercase;margin:20px 0 16px;">{{ about.territory.municipality_2_label }}</div>
        <div class="canton-grid">
{%- for c in about.territory.municipality_2 %}
          <div class="canton"><strong>Canton</strong>{{ c }}</div>
{%- endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="newsletter" style="background:var(--off-white)">
    <div class="newsletter-text"><h2 style="color:var(--blue)">{{ about.newsletter.title }}</h2><p style="color:var(--gray-500)">{{ about.newsletter.text }}</p></div>
    <form class="newsletter-form" data-ls-form="lwq6BdFgS6AoJDZUUkNE" novalidate>
      <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" data-ls-field="_hp" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
        <input type="email" class="newsletter-input" name="Email" data-ls-field="email" placeholder="your@email.com" aria-label="Email address" required>
        <button type="submit" class="newsletter-btn">{{ about.newsletter.button }}</button>
      </form>
  </div>
  {% include "footer.njk" %}
</div>

<!-- ════════════════════════════ IMPACT (Cumulative Report 2023–2025) ════════════════════════════ -->
<div id="page-impact" class="page">

  <!-- IMPACT HERO -->
  <div class="impact-report-hero">
    <span class="badge">{{ impact.hero.badge }}</span>
    <h1>{{ impact.hero.title }}</h1>
    <p>{{ impact.hero.text }}</p>
  </div>

  <!-- KEY FIGURES -->
  <div class="impact-summary-grid">
{%- for f in impact.figures %}
    <div class="impact-summary-tile">
      <div class="impact-summary-num">{{ f.number }}</div>
      <div class="impact-summary-label">{{ f.label }}</div>
    </div>
{%- endfor %}
  </div>

  <!-- PERFORMANCE TABLE + BARS -->
  <section class="perf-section">
    <div class="section-label">{{ impact.performance.label }}</div>
    <div class="section-title" style="max-width:640px;">{{ impact.performance.title }}</div>
    <p class="section-sub" style="margin-top:16px;">{{ impact.performance.text }}</p>

    <table class="perf-table">
      <thead>
        <tr><th>Sector</th><th>Planned</th><th>Achieved</th><th>Rate</th></tr>
      </thead>
      <tbody>
{%- for s in impact.performance.sectors %}
        <tr><td>{{ s.name }}</td><td class="num">{{ s.planned }}</td><td class="num">{{ s.achieved }}</td><td class="num">{{ s.rate }}%</td></tr>
{%- endfor %}
      </tbody>
    </table>

    <div class="perf-bars">
{%- for s in impact.performance.sectors | byRateDesc %}
      <div class="perf-bar-row"><div class="perf-bar-label">{{ s.name }}</div><div class="perf-bar-track"><div class="perf-bar-fill{% if s.rate < 65 %} lo{% elif s.rate < 90 %} alt{% endif %}" style="width:{{ s.rate }}%"></div></div><div class="perf-bar-pct">{{ s.rate }}%</div></div>
{%- endfor %}
    </div>

    <!-- INSIGHTS -->
    <div class="insights-grid">
{%- for i in impact.insights %}
      <div class="insight-card{% if i.warning %} warn{% endif %}">
        <h4>{{ i.title }}</h4>
        <p>{{ i.text }}</p>
      </div>
{%- endfor %}
    </div>
  </section>

  <!-- COMMUNITY IMPACT -->
  <div class="community-impact">
    <div style="text-align:center;max-width:680px;margin:0 auto;">
      <div class="section-label">{{ impact.community.label }}</div>
      <div class="section-title">{{ impact.community.title }}</div>
    </div>
    <div class="community-impact-grid">
{%- for a in impact.community.areas %}
      <div class="ci-card">
        <div class="ci-card-header">
          <div class="ci-icon {{ a.color }}">{{ a.icon }}</div>
          <h3>{{ a.title }}</h3>
        </div>
        <ul>
{%- for pt in a.points %}
          <li>{{ pt }}</li>
{%- endfor %}
        </ul>
      </div>
{%- endfor %}
    </div>
  </div>

  <!-- KEY CHALLENGES -->
  <section class="challenges">
    <div style="max-width:760px;">
      <div class="section-label">{{ impact.challenges.label }}</div>
      <div class="section-title">{{ impact.challenges.title }}</div>
    </div>
    <div class="challenges-list">
{%- for c in impact.challenges.items %}
      <div class="challenge">{{ c }}</div>
{%- endfor %}
    </div>
  </section>

  <!-- STRATEGIC PRIORITY: KPOTAMÉ -->
  <div class="strategic-priority">
    <div>
      <div class="section-label" style="color:rgba(245,194,0,0.85)">{{ impact.priority.label }}</div>
      <h2>{{ impact.priority.title }}</h2>
{%- for para in impact.priority.paragraphs %}
      <p>{{ para }}</p>
{%- endfor %}
      <ul>
{%- for s in impact.priority.services %}
        <li>{{ s }}</li>
{%- endfor %}
      </ul>
      <a href="#" onclick="showPage('project')" class="btn-primary" style="margin-top:16px;display:inline-block;">{{ impact.priority.button }}</a>
    </div>
    <div class="sp-image"></div>
  </div>

  <!-- STRATEGIC OUTLOOK -->
  <section class="outlook">
    <div style="text-align:center;max-width:680px;margin:0 auto;">
      <div class="section-label">{{ impact.outlook.label }}</div>
      <div class="section-title">{{ impact.outlook.title }}</div>
    </div>
    <div class="outlook-grid">
{%- for o in impact.outlook.items %}
      <div class="outlook-card">
        <div class="outlook-num">{{ loop.index | pad2 }}</div>
        <p>{{ o }}</p>
      </div>
{%- endfor %}
    </div>
  </section>

  <!-- WHY SUPPORT -->
  <div class="why-support">
    <div class="section-label">{{ impact.why.label }}</div>
    <div class="section-title" style="max-width:640px;">{{ impact.why.title }}</div>
    <div class="why-list">
{%- for r in impact.why.reasons %}
      <div class="why-item">{{ r }}</div>
{%- endfor %}
    </div>
    <div style="margin-top:48px;display:flex;gap:16px;flex-wrap:wrap;">
      <a href="#" onclick="showPage('donate')" class="btn-primary" style="background:var(--blue);color:var(--white);">{{ impact.why.primary_button }}</a>
      <a href="#" onclick="showPage('contact')" class="btn-outline" style="color:var(--blue);border-color:var(--blue);">{{ impact.why.secondary_button }}</a>
    </div>
  </div>

  {% include "footer.njk" %}
</div>

<!-- ════════════════════════════ PROJECT ════════════════════════════ -->
<div id="page-project" class="page">
  <div class="project-hero">
    <div class="section-label" style="color:rgba(245,194,0,0.85)">{{ project.hero.label }}</div>
    <h1>{{ project.hero.title }}</h1>
    <p>{{ project.hero.text }}</p>
    <div class="funding-card">
      <h3>{{ project.hero.funding_title }}</h3>
      <div class="funding-amount">{{ site.fundraising.raised }}</div>
      <div class="funding-goal">raised toward {{ site.fundraising.phase_goal }} goal · Part of {{ site.fundraising.project_total }} total project</div>
      <div class="funding-bar"><div class="funding-fill"></div></div>
      <div class="funding-meta"><span>{{ site.fundraising.percent_funded }}% funded</span><span>{{ site.fundraising.phase_name }}</span></div>
    </div>
  </div>

  <div class="project-phases">
    <div class="section-label">{{ project.roadmap.label }}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:end">
      <div class="section-title">{{ project.roadmap.title }}</div>
      <p class="section-sub">{{ project.roadmap.text }}</p>
    </div>
    <div class="phase-list">
{%- for ph in project.roadmap.phases %}
      <div class="phase-item">
        <div class="phase-num"{% if ph.status == "active" %} style="color:var(--teal);opacity:1"{% endif %}>{{ loop.index | pad2 }}</div>
        <div class="phase-content">
          <h3>{{ ph.title }}</h3>
          <p>{{ ph.text }}</p>
          <div class="phase-status {{ ph.status }}">{{ ph.status_text }}</div>
        </div>
      </div>
{%- endfor %}
    </div>
  </div>

  <div class="partner-levels">
    <div class="section-label">{{ project.partners.label }}</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:end;margin-bottom:0">
      <div class="section-title">{{ project.partners.title }}</div>
      <p class="section-sub">{{ project.partners.text }}</p>
    </div>
    <div class="levels-grid">
{%- for l in project.partners.levels %}
      <div class="level-card{% if l.featured %} featured{% endif %}">
        {% if l.featured and l.tag %}<div class="level-tag">{{ l.tag }}</div>{% endif %}
        <div class="level-amount">{{ l.amount }}</div>
        <div class="level-title">{{ l.title }}</div>
        <p class="level-desc">{{ l.text }}</p>
        <a href="#" onclick="showPage('donate')" class="level-btn {% if l.featured %}solid{% else %}outline{% endif %}">{{ l.button }}</a>
      </div>
{%- endfor %}
    </div>
  </div>
  {% include "footer.njk" %}
</div>

<!-- ════════════════════════════ GET INVOLVED ════════════════════════════ -->
<div id="page-involve" class="page">
  <div class="involve-hero">
    <div class="section-label">{{ involve.hero.label }}</div>
    <div class="section-title">{{ involve.hero.title }}</div>

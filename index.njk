<script>
const pageTitles = {
  home:    'APED Association — Building Hope in Rural Togo',
  about:   'About APED — Our Mission, Team, and Story',
  impact:  'Impact Report 2023–2025 — APED Association',
  project: 'Kpotamé Rural Health Center — APED Association',
  involve: 'Get Involved — Volunteer or Partner with APED',
  contact: 'Contact APED Association',
  donate:  'Donate — Help Build the Kpotamé Health Center',
  news:    'News — APED Association',
  thanks:  'Welcome to APED — Check Your Inbox'
};
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const target = document.getElementById('page-' + id);
  if (!target) return;
  target.classList.add('active');
  document.querySelectorAll('.nav-links a').forEach(a => a.classList.remove('active'));
  const navEl = document.getElementById('nav-' + id);
  if (navEl) navEl.classList.add('active');
  document.querySelector('nav').classList.remove('nav-open');
  if (pageTitles[id]) document.title = pageTitles[id];
  if (history.replaceState) history.replaceState(null, '', '#' + id);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
function toggleNav() {
  document.querySelector('nav').classList.toggle('nav-open');
}
function selectAmount(btn) {
  document.querySelectorAll('.amount-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  const m = btn.textContent.match(/\$[\d,]+/);
  document.querySelector('.donate-btn').textContent = 'Donate ' + (m ? m[0] : '') + ' Now →';
}
function setFreq(btn) {
  document.querySelectorAll('.freq-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}
// Open the APED Donorbox campaign, carrying the chosen amount + frequency
const DONORBOX_URL = 'https://donorbox.org/rural-health-center-for-women-and-children-kpotame-assahoun-togo-943932';
function goDonate() {
  const sel = document.querySelector('.amount-btn.selected');
  const custom = document.querySelector('.custom-input');
  let amt = '';
  if (custom && custom.value.replace(/[^0-9.]/g, '')) amt = custom.value.replace(/[^0-9.]/g, '');
  else if (sel) { const m = sel.textContent.match(/[\d,]+/); if (m) amt = m[0].replace(/,/g, ''); }
  const freq = document.querySelector('.freq-btn.active');
  const monthly = freq && /month/i.test(freq.textContent);
  const url = DONORBOX_URL + '?' + (amt ? 'amount=' + amt + '&' : '') + 'default_interval=' + (monthly ? 'm' : 'o');
  window.open(url, '_blank', 'noopener');
}

/* ── Website forms → the APED workspace ──────────────────────────────────
   Contact and volunteer submissions post straight into APED's own workspace,
   which then emails apedassoc@gmail.com with every answer and the sender's
   address set as Reply-To. Nothing to activate, nothing to click. If the
   request ever fails, the visitor is shown the email address rather than a
   dead button. */
(function () {
  var ENDPOINT = 'https://go.draftclicks.com/api/forms/';
  var FALLBACK_EMAIL = 'apedassoc@gmail.com';

  function attribution() {
    var p = new URLSearchParams(window.location.search);
    return {
      utmSource: p.get('utm_source') || '',
      utmMedium: p.get('utm_medium') || '',
      utmCampaign: p.get('utm_campaign') || '',
      landingPage: window.location.href,
      referrer: document.referrer || ''
    };
  }

  function collect(form) {
    var values = {};
    form.querySelectorAll('[data-ls-field]').forEach(function (el) {
      values[el.getAttribute('data-ls-field')] = (el.value || '').trim();
    });
    var first = form.querySelector('[data-ls-name-part="first"]');
    var last = form.querySelector('[data-ls-name-part="last"]');
    if (first || last) {
      values.name = [first && first.value, last && last.value]
        .filter(Boolean).join(' ').trim();
    }
    return values;
  }

  function notice(form, text, ok) {
    var el = form.querySelector('.form-notice');
    if (!el) {
      el = document.createElement('p');
      el.className = 'form-notice';
      el.style.cssText = 'margin-top:14px;font-size:14px;line-height:1.6;flex-basis:100%;';
      form.appendChild(el);
    }
    var onDark = form.classList.contains('newsletter-form');
    el.style.color = ok
      ? (onDark ? 'rgba(255,255,255,0.85)' : 'var(--teal)')
      : (onDark ? 'var(--yellow)' : '#b3261e');
    el.innerHTML = text;
  }

  document.querySelectorAll('form[data-ls-form]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      var button = form.querySelector('button[type="submit"]');
      var label = button ? button.textContent : '';
      if (button) { button.disabled = true; button.textContent = 'Sending...'; }
      notice(form, '', true);

      fetch(ENDPOINT + form.getAttribute('data-ls-form') + '/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ values: collect(form), attribution: attribution() })
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Request failed');
          return res.json();
        })
        .then(function (data) {
          form.reset();
          if (button) { button.disabled = true; button.textContent = 'Sent'; }
          notice(form, (data && data.thankYouMessage) ||
            'Thank you. Your message has reached APED, and someone will reply by email.', true);
        })
        .catch(function () {
          if (button) { button.disabled = false; button.textContent = label; }
          notice(form,
            'Something went wrong sending that. Please email us directly at ' +
            '<a href="mailto:' + FALLBACK_EMAIL + '" style="color:inherit">' + FALLBACK_EMAIL + '</a>.',
            false);
        });
    });
  });
})();

// Prevent placeholder href="#" links from jumping the hash back to empty (which bounced nav to home)
document.addEventListener('click', function (e) {
  var a = e.target.closest ? e.target.closest('a[href="#"]') : null;
  if (a) e.preventDefault();
});

// Hash routing: if the URL has a hash like #thanks or #about on load, route to that page
(function routeFromHash() {
  const hash = (window.location.hash || '').replace('#', '').toLowerCase();
  if (hash && pageTitles[hash]) {
    showPage(hash);
  }
})();
// Also respond to back/forward navigation
window.addEventListener('hashchange', function () {
  const hash = (window.location.hash || '').replace('#', '').toLowerCase();
  if (hash && pageTitles[hash]) {
    showPage(hash);
  } else if (!hash) {
    showPage('home');
  }
});
</script>
</body>
</html>

<style>
  :root {
    --blue: #1A3A6B;
    --blue-mid: #2B5BA8;
    --blue-light: #D6E8F7;
    --yellow: #F5C200;
    --yellow-dark: #C49A00;
    --teal: #0D8C6A;
    --teal-light: #E0F5EE;
    --white: #FFFFFF;
    --off-white: #F8F6F0;
    --gray-100: #F2F0EA;
    --gray-300: #C8C5BC;
    --gray-500: #7A7870;
    --gray-700: #3D3C38;
    --gray-900: #1C1B18;
    --serif: 'Playfair Display', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
    --radius: 4px;
    --radius-lg: 12px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  body { font-family: var(--sans); background: var(--white); color: var(--gray-900); font-size: 16px; line-height: 1.7; overflow-x: hidden; max-width: 100vw; }
  img { max-width: 100%; height: auto; }

  /* ─── NAV ─── */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--gray-100);
    padding: 0 40px;
    display: flex; align-items: center; justify-content: space-between;
    height: 70px;
  }
  .nav-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .nav-logo-img { width: 48px; height: 48px; object-fit: contain; flex-shrink: 0; }
  .nav-logo-text { font-family: var(--serif); font-size: 18px; font-weight: 700; color: var(--blue); letter-spacing: -0.3px; }
  .nav-logo-sub { font-size: 11px; color: var(--gray-500); letter-spacing: 0.5px; }
  .nav-links { display: flex; align-items: center; gap: 32px; }
  .nav-links a { font-size: 14px; color: var(--gray-700); text-decoration: none; font-weight: 400; transition: color .2s; }
  .nav-links a:hover, .nav-links a.active { color: var(--blue); font-weight: 500; }
  .nav-cta {
    background: var(--yellow); color: var(--blue); font-family: var(--sans);
    font-weight: 600; font-size: 14px; padding: 10px 22px;
    border-radius: var(--radius); border: none; cursor: pointer;
    text-decoration: none; transition: background .2s, transform .1s;
    letter-spacing: 0.2px;
  }
  .nav-cta:hover { background: var(--yellow-dark); transform: translateY(-1px); }

  /* ─── PAGES ─── */
  .page { display: none; }
  .page.active { display: block; }

  /* ─── HERO ─── */
  .hero {
    background: var(--blue);
    min-height: 85vh;
    display: grid; grid-template-columns: 1fr 1fr;
    position: relative; overflow: hidden;
  }
  .hero-pattern {
    position: absolute; inset: 0; opacity: 0.04;
    background-image: radial-gradient(circle, #fff 1px, transparent 1px);
    background-size: 32px 32px;
  }
  .hero-left {
    padding: 80px 60px 80px 80px;
    display: flex; flex-direction: column; justify-content: center;
    position: relative; z-index: 2;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(245,194,0,0.15); border: 1px solid rgba(245,194,0,0.4);
    color: var(--yellow); font-size: 12px; font-weight: 500; letter-spacing: 1.5px;
    text-transform: uppercase; padding: 6px 14px; border-radius: 100px;
    margin-bottom: 28px; width: fit-content;
  }
  .hero-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--yellow); }
  .hero h1 {
    font-family: var(--serif); font-size: clamp(38px, 4.5vw, 58px);
    color: var(--white); line-height: 1.1; margin-bottom: 24px;
    font-weight: 700;
  }
  .hero h1 em { font-style: italic; color: var(--yellow); }
  .hero-sub {
    font-size: 17px; color: rgba(255,255,255,0.72); max-width: 480px;
    margin-bottom: 44px; line-height: 1.75;
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--yellow); color: var(--blue); font-family: var(--sans);
    font-weight: 600; font-size: 15px; padding: 14px 28px; border-radius: var(--radius);
    border: none; cursor: pointer; text-decoration: none; display: inline-block;
    transition: background .2s, transform .15s;
  }
  .btn-primary:hover { background: var(--yellow-dark); transform: translateY(-2px); }
  .btn-outline {
    background: transparent; color: var(--white); font-family: var(--sans);
    font-weight: 500; font-size: 15px; padding: 14px 28px; border-radius: var(--radius);
    border: 1px solid rgba(255,255,255,0.3); cursor: pointer; text-decoration: none;
    display: inline-block; transition: border-color .2s, background .2s;
  }
  .btn-outline:hover { border-color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.07); }
  .hero-right {
    position: relative; overflow: hidden;
    display: grid; grid-template-rows: 1fr 1fr; gap: 4px;
    min-height: 500px;
  }
  .hero-img {
    background-size: cover; background-position: center;
    position: relative; min-height: 240px;
  }
  .hero-img-top::after { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse at 90% 90%, rgba(26,58,107,0.72) 0%, transparent 55%); pointer-events: none; }
  .hero-img-top { background-image: url('{{ home.hero.photo_top | asset }}'); }
  .hero-img-bottom { background-image: url('{{ home.hero.photo_bottom | asset }}'); }
  .hero-img-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(26,58,107,0.3) 0%, transparent 60%); }
  .hero-caption {
    position: absolute; bottom: 16px; left: 16px;
    background: rgba(255,255,255,0.95); border-radius: var(--radius);
    padding: 8px 14px; font-size: 12px; color: var(--gray-700); font-weight: 500;
  }
  .hero-stats {
    background: #0D8C6A;
    display: flex; padding: 36px 80px; gap: 80px; align-items: center;
    width: 100%;
  }
  .hero-stat { text-align: center; }
  .hero-stat-num { font-family: var(--serif); font-size: 26px; font-weight: 700; color: var(--white); }
  .hero-stat-label { font-size: 12px; color: rgba(255,255,255,0.75); letter-spacing: 0.5px; margin-top: 2px; }

  /* ─── SECTION BASE ─── */
  section { padding: 96px 80px; }
  .section-label {
    font-size: 11px; font-weight: 600; letter-spacing: 2.5px;
    text-transform: uppercase; color: var(--teal); margin-bottom: 16px;
  }
  .section-title {
    font-family: var(--serif); font-size: clamp(30px, 3vw, 44px);
    line-height: 1.15; color: var(--blue); margin-bottom: 20px; font-weight: 700;
  }
  .section-sub { font-size: 17px; color: var(--gray-500); max-width: 600px; line-height: 1.75; }

  /* ─── PROGRAMS ─── */
  .programs-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1px; margin-top: 64px;
    border: 1px solid var(--gray-100); border-radius: var(--radius-lg); overflow: hidden;
  }
  .program-card {
    background: var(--white); padding: 36px 28px;
    border-right: 1px solid var(--gray-100);
    transition: background .2s; cursor: pointer; position: relative;
    overflow: hidden;
  }
  .program-card:last-child { border-right: none; }
  .program-card:hover { background: var(--off-white); }
  .program-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--yellow); transform: scaleX(0); transform-origin: left;
    transition: transform .3s;
  }
  .program-card:hover::before { transform: scaleX(1); }
  .program-icon {
    width: 48px; height: 48px; border-radius: var(--radius);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; margin-bottom: 20px;
  }
  .program-icon.edu { background: #EBF3FF; }
  .program-icon.health { background: var(--teal-light); }
  .program-icon.women { background: #FFF3E0; }
  .program-icon.civic { background: #F3E8FF; }
  .program-card h3 { font-family: var(--serif); font-size: 18px; color: var(--blue); margin-bottom: 12px; font-weight: 700; }
  .program-card p { font-size: 14px; color: var(--gray-500); line-height: 1.7; }
  .program-link { display: inline-block; margin-top: 20px; font-size: 13px; font-weight: 600; color: var(--teal); text-decoration: none; }
  .program-link:hover { text-decoration: underline; }

  /* ─── STORY STRIP ─── */
  .story-strip {
    background: var(--blue); padding: 96px 80px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
  }
  .story-img-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px; border-radius: var(--radius-lg); overflow: hidden;
  }
  .story-img-cell { aspect-ratio: 4/3; background-size: cover; background-position: center; border-radius: var(--radius); }
  .story-img-1 { background-image: url('{{ home.story.photo_1 | asset }}'); }
  .story-img-2 { background-image: url('{{ home.story.photo_2 | asset }}'); }
  .story-img-3 { background-image: url('{{ home.story.photo_3 | asset }}'); }
  .story-img-4 { background-image: url('{{ home.story.photo_4 | asset }}'); }
  .story-text .section-title { color: var(--white); }
  .story-text .section-sub { color: rgba(255,255,255,0.65); max-width: 100%; }
  .story-quote {
    border-left: 3px solid var(--yellow); padding-left: 20px;
    margin: 32px 0; font-family: var(--serif); font-style: italic;
    font-size: 18px; color: rgba(255,255,255,0.85); line-height: 1.6;
  }
  .story-text .btn-primary { margin-top: 8px; }

  /* ─── IMPACT NUMBERS ─── */
  .impact-section { background: var(--gray-100); text-align: center; padding: 80px; }
  .impact-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 0; margin-top: 56px; }
  .impact-item { padding: 40px 20px; border-right: 1px solid var(--gray-300); }
  .impact-item:last-child { border-right: none; }
  .impact-num { font-family: var(--serif); font-size: 52px; font-weight: 900; color: var(--blue); line-height: 1; }
  .impact-unit { font-size: 24px; color: var(--teal); }
  .impact-label { font-size: 13px; color: var(--gray-500); letter-spacing: 0.5px; margin-top: 8px; }

  /* ─── HEALTH CENTER SPOTLIGHT ─── */
  .spotlight {
    background: var(--blue); padding: 96px 80px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;
  }
  .spotlight-visual { position: relative; }
  .spotlight-photo {
    width: 100%; aspect-ratio: 4/3; border-radius: var(--radius-lg);
    background: url('{{ home.spotlight.photo | asset }}') center/cover;
    position: relative;
  }
  .progress-card {
    position: absolute; bottom: -28px; right: -28px;
    background: var(--white); border-radius: var(--radius-lg);
    padding: 20px 24px; box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    min-width: 220px;
  }
  .progress-card h4 { font-size: 13px; color: var(--gray-500); margin-bottom: 10px; }
  .progress-bar-track { height: 8px; background: var(--gray-100); border-radius: 100px; overflow: hidden; }
  .progress-bar-fill { height: 100%; background: var(--teal); border-radius: 100px; width: {{ site.fundraising.percent_funded }}%; }
  .progress-meta { display: flex; justify-content: space-between; margin-top: 10px; font-size: 13px; }
  .progress-meta strong { color: var(--blue); font-weight: 600; }
  .progress-meta span { color: var(--gray-500); }
  .spotlight-content { padding-left: 20px; }
  .milestone-list { list-style: none; margin-top: 32px; }
  .milestone-list li {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 15px;
  }
  .milestone-list li:last-child { border-bottom: none; }
  .milestone-dot {
    width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; margin-top: 2px;
  }
  .milestone-dot.done { background: var(--teal); color: var(--white); }
  .milestone-dot.active { background: var(--yellow); color: var(--blue); }
  .milestone-dot.pending { background: var(--gray-100); color: var(--gray-500); border: 1px dashed var(--gray-300); }
  .milestone-text strong { display: block; font-weight: 600; color: var(--white); font-size: 15px; }
  .milestone-text span { font-size: 13px; color: rgba(255,255,255,0.55); }

  /* ─── TESTIMONIAL ─── */
  .testimonials { padding: 96px 80px; }
  .testimonial-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px; }
  .testimonial-card {
    background: var(--off-white); border-radius: var(--radius-lg); padding: 36px;
    position: relative;
  }
  .testimonial-card::before {
    content: '\201C'; font-family: var(--serif); font-size: 80px; color: var(--blue);
    opacity: 0.1; position: absolute; top: 12px; left: 24px; line-height: 1;
  }
  .testimonial-text { font-size: 15px; color: var(--gray-700); line-height: 1.75; position: relative; z-index: 1; }
  .testimonial-author { margin-top: 24px; display: flex; align-items: center; gap: 12px; }
  .testimonial-avatar {
    width: 40px; height: 40px; border-radius: 50%; background: var(--blue);
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 700; color: var(--white); flex-shrink: 0;
  }
  .testimonial-name { font-weight: 600; font-size: 14px; color: var(--gray-900); }
  .testimonial-role { font-size: 12px; color: var(--gray-500); }

  /* ─── NEWSLETTER ─── */
  .newsletter {
    background: var(--blue); padding: 80px;
    display: flex; align-items: center; justify-content: space-between; gap: 48px;
  }
  .newsletter-text h2 { font-family: var(--serif); font-size: 32px; color: var(--white); margin-bottom: 8px; }
  .newsletter-text p { color: rgba(255,255,255,0.6); font-size: 15px; }
  .newsletter-form { display: flex; gap: 12px; flex-shrink: 0; }
  .newsletter-input {
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25);
    color: var(--white); font-family: var(--sans); font-size: 15px;
    padding: 12px 20px; border-radius: var(--radius); width: 280px; outline: none;
    transition: border-color .2s;
  }
  .newsletter-input::placeholder { color: rgba(255,255,255,0.4); }
  .newsletter-input:focus { border-color: rgba(255,255,255,0.6); }
  .newsletter-btn {
    background: var(--yellow); color: var(--blue); font-family: var(--sans);
    font-weight: 600; font-size: 15px; padding: 12px 24px; border-radius: var(--radius);
    border: none; cursor: pointer; white-space: nowrap; transition: background .2s;
  }
  .newsletter-btn:hover { background: var(--yellow-dark); }

  /* ─── FOOTER ─── */
  footer {
    background: var(--gray-900); padding: 60px 80px 40px;
  }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 48px; }
  .footer-brand .nav-logo-text { color: var(--white); }
  .footer-brand .nav-logo-sub { color: rgba(255,255,255,0.4); }
  .footer-brand p { font-size: 14px; color: rgba(255,255,255,0.5); margin-top: 16px; line-height: 1.7; max-width: 260px; }
  .footer-col h4 { font-size: 12px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 16px; }
  .footer-col a { display: block; font-size: 14px; color: rgba(255,255,255,0.6); text-decoration: none; margin-bottom: 10px; transition: color .2s; }
  .footer-col a:hover { color: var(--white); }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 32px; display: flex; justify-content: space-between; align-items: center; }
  .footer-bottom p { font-size: 13px; color: rgba(255,255,255,0.35); }
  .footer-email { font-size: 13px; color: var(--yellow); }

  /* ─── ABOUT PAGE ─── */
  .about-hero { background: var(--off-white); padding: 96px 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .about-body { padding: 96px 80px; }
  .about-body .section-sub { max-width: 760px; font-size: 18px; line-height: 1.8; color: var(--gray-700); }
  .values-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-top: 56px; }
  .value-card {
    border: 1px solid var(--gray-100); border-radius: var(--radius-lg);
    padding: 32px; transition: border-color .2s, box-shadow .2s;
  }
  .value-card:hover { border-color: var(--blue-mid); box-shadow: 0 4px 20px rgba(26,58,107,0.08); }
  .value-num { font-family: var(--serif); font-size: 40px; color: var(--gray-100); font-weight: 900; line-height: 1; margin-bottom: 12px; }
  .value-card h3 { font-family: var(--serif); font-size: 20px; color: var(--blue); margin-bottom: 12px; }
  .value-card p { font-size: 14px; color: var(--gray-500); line-height: 1.7; }
  .territory { background: var(--blue); padding: 80px; margin: 0; }
  .territory-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .territory h2 { font-family: var(--serif); font-size: 36px; color: var(--white); margin-bottom: 16px; }
  .territory p { color: rgba(255,255,255,0.65); font-size: 16px; line-height: 1.75; margin-bottom: 20px; }
  .canton-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
  .canton { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius); padding: 12px 16px; font-size: 14px; color: rgba(255,255,255,0.75); }
  .canton strong { display: block; color: var(--yellow); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }

  /* ─── PROJECT PAGE ─── */
  .project-hero { background: var(--blue); padding: 96px 80px; color: var(--white); }
  .project-hero h1 { font-family: var(--serif); font-size: 52px; max-width: 700px; margin: 24px 0; line-height: 1.1; }
  .project-hero p { color: rgba(255,255,255,0.65); font-size: 18px; max-width: 560px; }
  .funding-card {
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-lg); padding: 32px; margin-top: 48px; max-width: 560px;
  }
  .funding-card h3 { font-size: 14px; color: rgba(255,255,255,0.6); margin-bottom: 12px; letter-spacing: 0.5px; }
  .funding-amount { font-family: var(--serif); font-size: 42px; color: var(--white); margin-bottom: 6px; }
  .funding-goal { font-size: 14px; color: rgba(255,255,255,0.5); margin-bottom: 20px; }
  .funding-bar { height: 10px; background: rgba(255,255,255,0.1); border-radius: 100px; overflow: hidden; }
  .funding-fill { height: 100%; background: var(--yellow); border-radius: 100px; width: {{ site.fundraising.percent_funded }}%; }
  .funding-meta { display: flex; justify-content: space-between; margin-top: 12px; font-size: 13px; color: rgba(255,255,255,0.5); }
  .project-phases { padding: 96px 80px; }
  .phase-list { margin-top: 56px; }
  .phase-item { display: grid; grid-template-columns: 80px 1fr; gap: 32px; padding: 40px 0; border-bottom: 1px solid var(--gray-100); }
  .phase-item:last-child { border-bottom: none; }
  .phase-num { font-family: var(--serif); font-size: 48px; font-weight: 900; color: var(--gray-100); line-height: 1; padding-top: 4px; }
  .phase-content h3 { font-family: var(--serif); font-size: 24px; color: var(--blue); margin-bottom: 10px; }
  .phase-content p { font-size: 15px; color: var(--gray-500); line-height: 1.7; max-width: 600px; }
  .phase-status { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; padding: 5px 14px; border-radius: 100px; font-size: 12px; font-weight: 600; }
  .phase-status.active { background: var(--teal-light); color: var(--teal); }
  .phase-status.complete { background: #EBF3FF; color: var(--blue-mid); }
  .phase-status.pending { background: var(--gray-100); color: var(--gray-500); }
  .phase-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .partner-levels { background: var(--off-white); padding: 96px 80px; }
  .levels-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-top: 56px; }
  .level-card {
    background: var(--white); border-radius: var(--radius-lg); padding: 36px;
    border: 1px solid var(--gray-100); position: relative; overflow: hidden;
  }
  .level-card.featured { border-color: var(--teal); }
  .level-tag {
    position: absolute; top: 0; right: 0; background: var(--teal); color: var(--white);
    font-size: 11px; font-weight: 600; letter-spacing: 0.5px; padding: 6px 16px;
    border-bottom-left-radius: var(--radius-lg);
  }
  .level-amount { font-family: var(--serif); font-size: 36px; font-weight: 700; color: var(--blue); margin-bottom: 6px; }
  .level-title { font-size: 13px; color: var(--teal); font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 20px; }
  .level-desc { font-size: 14px; color: var(--gray-500); line-height: 1.7; }
  .level-btn {
    display: block; width: 100%; text-align: center; margin-top: 28px;
    padding: 12px; border-radius: var(--radius); font-family: var(--sans);
    font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none;
    transition: all .2s;
  }
  .level-btn.outline { border: 1.5px solid var(--blue); color: var(--blue); background: transparent; }
  .level-btn.outline:hover { background: var(--blue); color: var(--white); }
  .level-btn.solid { background: var(--teal); color: var(--white); border: none; }
  .level-btn.solid:hover { background: var(--blue); }

  /* ─── GET INVOLVED ─── */
  .involve-hero { background: var(--off-white); padding: 96px 80px; }
  .involve-options { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-top: 64px; }
  .involve-card {
    background: var(--white); border-radius: var(--radius-lg); padding: 40px;

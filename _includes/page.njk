<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | APED Association</title>
<meta name="description" content="{{ intro or title }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://apedassociation.org{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="APED Association">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ intro or title }}">
<meta property="og:url" content="https://apedassociation.org{{ page.url }}">
<meta property="og:image" content="https://apedassociation.org/{{ (photo | asset) if photo else 'assets/brand/og-card.jpg' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png">
<meta name="theme-color" content="#1A3A6B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
{% include "styles.njk" %}
<style>
  .extra-page { max-width: 820px; margin: 0 auto; }
  .extra-page h1.section-title { margin-top: 8px; }
  .extra-page-photo { width: 100%; max-height: 560px; object-fit: cover; border-radius: var(--radius-lg); margin: 32px 0 8px; display: block; }
  .page-body { font-size: 17px; line-height: 1.8; color: var(--gray-700); margin-top: 24px; }
  .page-body h2, .page-body h3 { font-family: var(--serif); color: var(--blue); line-height: 1.25; margin: 36px 0 12px; }
  .page-body h2 { font-size: 30px; } .page-body h3 { font-size: 24px; }
  .page-body p { margin: 0 0 18px; }
  .page-body ul, .page-body ol { margin: 0 0 18px 22px; }
  .page-body li { margin-bottom: 6px; }
  .page-body a { color: var(--teal); }
  .page-body img { max-width: 100%; border-radius: var(--radius); }
</style>
</head>
<body>
{% include "nav.njk" %}
<div class="page active">
  <div class="about-body">
    <div class="extra-page">
      {% if label %}<div class="section-label">{{ label }}</div>{% endif %}
      <h1 class="section-title">{{ title }}</h1>
      {% if intro %}<p class="section-sub" style="margin-top:16px">{{ intro }}</p>{% endif %}
      {% if photo %}<img class="extra-page-photo" src="/{{ photo | asset }}" alt="{{ title }}" loading="eager" decoding="async">{% endif %}
      <div class="page-body">{{ content | safe }}</div>
      {% if button_label and button_link %}<a href="{{ button_link }}" class="btn-primary" style="margin-top:16px;display:inline-block;"{% if button_link.startsWith("http") %} target="_blank" rel="noopener"{% endif %}>{{ button_label }}</a>{% endif %}
    </div>
  </div>
  {% include "footer.njk" %}
</div>
<script>
function toggleNav() { document.querySelector('nav').classList.toggle('nav-open'); }
</script>
</body>
</html>
